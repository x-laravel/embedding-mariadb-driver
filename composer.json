{
    "name": "x-laravel/embedding-mariadb-driver",
    "description": "MariaDB 11.7 native vector similarity driver for x-laravel/embedding.",
    "keywords": ["laravel", "mariadb", "embedding", "vector", "ai"],
    "license": "MIT",
    "authors": [
        {
            "name": "X-Adam",
            "email": "www@mehmetogmen.com.tr",
            "homepage": "https://mehmetogmen.com.tr"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "x-laravel/embedding": "^1.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "XLaravel\\Embedding\\Driver\\Mariadb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XLaravel\\Embedding\\Driver\\Mariadb\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XLaravel\\Embedding\\Driver\\Mariadb\\MariadbEmbeddingServiceProvider"
            ]
        }
    }
}
